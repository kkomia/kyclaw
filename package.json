{
  "name": "kyclaw",
  "version": "0.1.0-beta.3",
  "description": "kyclaw：Kimi 风格三栏桌面应用（Electron + React + 内嵌 Mastra agent）",
  "main": "./out/main/index.js",
  "author": "kkomia",
  "homepage": "https://electron-vite.org",
  "engines": {
    "node": ">=22.13.0"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --cache .",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web && pnpm run typecheck:e2e",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "test": "vitest run",
    "test:e2e": "pnpm run build && playwright test",
    "build": "electron-vite build",
    "fetch:llama": "node scripts/fetch-llama.mjs",
    "fetch:libreoffice-kit": "node scripts/fetch-libreoffice-kit.mjs",
    "package": "node scripts/package.mjs",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run build",
    "postinstall": "install-electron && electron-builder install-app-deps",
    "build:unpack": "pnpm run build && electron-builder --dir",
    "build:win": "pnpm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.78",
    "@ai-sdk/deepseek": "3.0.63",
    "@ai-sdk/openai-compatible": "3.0.67",
    "@electron-toolkit/utils": "4.0.0",
    "@hono/node-server": "2.1.4",
    "@mastra/ai-sdk": "1.10.7",
    "@mastra/core": "1.75.0",
    "@mastra/hono": "1.7.17",
    "@mastra/langfuse": "1.5.13",
    "@mastra/libsql": "1.25.1",
    "@mastra/mcp": "2.2.0",
    "@mastra/memory": "1.36.0",
    "@mastra/observability": "1.18.4",
    "ai": "7.0.137",
    "docx": "9.9.0",
    "electron-updater": "6.8.9",
    "exceljs": "4.4.0",
    "hono": "4.13.13",
    "mammoth": "1.13.0",
    "node-pty": "1.1.0",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1"
  },
  "devDependencies": {
    "@ai-sdk/react": "4.0.140",
    "@electron-toolkit/eslint-config-prettier": "3.0.1",
    "@electron-toolkit/eslint-config-ts": "3.1.0",
    "@electron-toolkit/tsconfig": "2.0.0",
    "@playwright/test": "1.64.0",
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-dropdown-menu": "2.1.25",
    "@radix-ui/react-popover": "1.2.0",
    "@radix-ui/react-tooltip": "1.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "9.39.5",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.4.26",
    "jsdom": "30.1.2",
    "lucide-react": "1.54.0",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-router": "7.18.4",
    "remark-gfm": "4.0.1",
    "shiki": "4.5.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  }
}
